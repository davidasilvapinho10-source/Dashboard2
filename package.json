{
  "name": "dashboard2-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace server exec tsx watch src/index.ts\" \"npm --workspace client exec vite\"",
    "build": "npm run -ws build",
    "typecheck": "npm run -ws typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
